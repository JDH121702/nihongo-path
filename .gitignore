# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage/

# Next.js generated output
/.next/
/out/
/.open-next/

# Production build output
/build/
/dist/

# Tool caches
/.cache/
/.turbo/
/.vite/
.eslintcache

# Miscellaneous system files
.DS_Store
Thumbs.db
*.pem

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files and secrets
.env*
!.env.example
